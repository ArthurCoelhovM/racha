# Copie para .env e preencha com os dados do seu projeto no Supabase
# (Project Settings > API, ou o botão Connect no painel)
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Endereço onde a versão web vai ficar publicada (usado nos links de convite e de recuperar senha)
EXPO_PUBLIC_SITE_URL=https://super-organizador.vercel.app
