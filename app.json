{
  "expo": {
    "name": "Racha",
    "slug": "super-organizador-3021",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "superorganizador",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B4CF0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.superorganizador3021.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Racha",
      "shortName": "Organizador",
      "lang": "pt-BR",
      "themeColor": "#5B4CF0",
      "backgroundColor": "#F6F7FB"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B4CF0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "O Racha usa a câmera para ler o QR code do cupom fiscal.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B4CF0"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Racha usa suas fotos para anexar o comprovante de um gasto.",
          "cameraPermission": "O Racha usa a câmera para fotografar o comprovante de um gasto."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "owner": "coelho_von",
    "extra": {
      "eas": {
        "projectId": "7e26efa5-c1e3-44a6-8e36-7466fdacd4cc"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/7e26efa5-c1e3-44a6-8e36-7466fdacd4cc",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
